# The year of the release, not of the build: CRAN records the publication
# date, and development versions cite the year of the last release.
year <- if (!is.null(meta$`Date/Publication`)) {
  sub("-.*", "", meta$`Date/Publication`)
} else {
  "2026"
}

bibentry(
  bibtype = "Manual",
  title = "{mediamix}: Media Transforms and Attribution Path Construction",
  author = person("Justin", "Chase"),
  year = year,
  note = paste("R package version", meta$Version),
  url = "https://elkronos.github.io/mediamix/",
  textVersion = paste0(
    "Chase, J. (", year, "). mediamix: Media Transforms and Attribution ",
    "Path Construction. R package version ", meta$Version,
    ". https://elkronos.github.io/mediamix/"
  )
)
